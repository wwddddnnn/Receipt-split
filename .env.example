# Copy this file to .env and add your key. Never commit .env.
OPENAI_API_KEY=

# Docker Compose binds the API to localhost by default. Do not set this to
# 0.0.0.0 until HTTPS, authentication, and receipt authorization are in place.
RECEIPT_SPLIT_BIND_HOST=127.0.0.1
RECEIPT_SPLIT_PORT=8080
RECEIPT_SPLIT_MEMBERS=AmyTest,BenTest,CindyTest,DanTest

# Keep false for localhost Docker use. A public deployment must use an HTTPS
# reverse proxy and set this to true so the login cookie is HTTPS-only.
RECEIPT_SPLIT_COOKIE_SECURE=false
